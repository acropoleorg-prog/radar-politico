# Copie este arquivo para .env e preencha os valores

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Porta do servidor (Railway define automaticamente)
PORT=3000

# Senha para proteger o dashboard (defina uma senha forte)
DASHBOARD_PASSWORD=sua_senha_aqui

# Identidade editorial (usado nas legendas geradas)
BRAND_NAME=Acrópole
BRAND_HANDLE_X=@acropole
BRAND_HANDLE_IG=@acropole

# Tom das legendas: "informativo", "opinativo", "urgente"
POST_TONE=informativo
